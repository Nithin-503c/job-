# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/job-plus

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Gmail OTP email (used for "gmail otp authentication" during registration)
# Create an "App Password" on the Gmail account (Google Account -> Security ->
# 2-Step Verification -> App passwords). Do NOT use your normal Gmail password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# If SMTP isn't configured yet, the server still works: it logs the OTP to
# the console and (only when this is "true") also returns it in the API
# response so you can test the flow without email. Turn this OFF in production.
DEV_EXPOSE_OTP=true

# Frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Base URL this backend is reachable at, used to build absolute photo URLs
BACKEND_PUBLIC_URL=http://localhost:5000

# UPI VPA to fall back to when an employer hasn't set their own, so the QR
# code generated on "Work done" always has somewhere to point.
DEFAULT_UPI_VPA=jobplus@upi
